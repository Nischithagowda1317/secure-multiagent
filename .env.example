# Copy this file to .env and fill in your LLM provider and Supabase credentials.
JWT_SECRET=replace-this-with-a-long-random-secret-before-production
JWT_EXP_MINUTES=480

# openai or nvidia = API-generated answers; extractive = offline answers
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=120

# For NVIDIA keys, set LLM_PROVIDER=nvidia and use NVIDIA_API_KEY.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TIMEOUT_SECONDS=120

# Copy the Session pooler URI from Supabase > Connect; URL-encode the password.
DATA_BACKEND=supabase
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_SCHEMA=enterprise_ai
RUNTIME_BACKEND=auto

# tfidf is the zero-setup default. chroma is optional.
RAG_BACKEND=tfidf
CHROMA_PATH=runtime/chroma
CHROMA_COLLECTION=enterprise_knowledge

MAX_UPLOAD_MB=10
ROUTER_CONFIDENCE_THRESHOLD=0.60
DATASET_SNAPSHOT_DATE=2026-08-28
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000
