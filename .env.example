# Copy this file to .env. Defaults run fully offline with CSV + SQLite + TF-IDF.
JWT_SECRET=replace-this-with-a-long-random-secret-before-production
JWT_EXP_MINUTES=480

# extractive = no external LLM required; ollama = optional local generative answers
LLM_PROVIDER=extractive
LLM_FALLBACK_PROVIDER=extractive
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# csv is the zero-setup default. postgres is optional.
DATA_BACKEND=csv
DATABASE_URL=postgresql+psycopg://enterprise_user:enterprise_password@127.0.0.1:5432/enterprise_assistant
DATABASE_SCHEMA=enterprise_ai

# tfidf is the zero-setup default. chroma is optional.
RAG_BACKEND=tfidf
CHROMA_PATH=runtime/chroma
CHROMA_COLLECTION=enterprise_knowledge

MAX_UPLOAD_MB=10
ROUTER_CONFIDENCE_THRESHOLD=0.60
DATASET_SNAPSHOT_DATE=2026-08-28
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000
